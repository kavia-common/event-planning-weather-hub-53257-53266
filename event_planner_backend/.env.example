# Flask
FLASK_DEBUG=false
FLASK_SECRET_KEY=please-change

# OpenAPI metadata
API_TITLE=Event Planner API
API_VERSION=v1

# CORS (comma-separated or * for all)
CORS_ALLOW_ORIGINS=*

# Database:
# Option A: Single DATABASE_URL
# Examples:
#   sqlite:///events.db
#   postgresql+psycopg2://user:password@host:5432/events
#   mysql+pymysql://user:password@host:3306/events
DATABASE_URL=sqlite:///events.db

# Option B: Component parts (used if DATABASE_URL is not set)
DB_DIALECT=sqlite
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=events.db

# OpenWeather configuration (Required)
OPENWEATHER_API_KEY=your-openweather-api-key
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
