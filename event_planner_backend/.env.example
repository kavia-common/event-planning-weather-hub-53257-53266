# Flask server
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=3001
FLASK_DEBUG=false
FLASK_TESTING=false
FLASK_SECRET_KEY=change-me-in-production

# CORS
# For development you can set '*' or your frontend origin, e.g. http://localhost:3000
CORS_ALLOW_ORIGINS=*

# Database: provide DATABASE_URL or individual components. Defaults to sqlite:///events.db
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
DB_DIALECT=sqlite
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=events.db

# OpenWeather configuration
# IMPORTANT: Set your OpenWeather API key here
OPENWEATHER_API_KEY=REPLACE_WITH_YOUR_KEY
# Optionally override base URL
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# API Metadata
API_TITLE=Event Planner API
API_VERSION=v1

# Pagination default
DEFAULT_PAGE_SIZE=20
